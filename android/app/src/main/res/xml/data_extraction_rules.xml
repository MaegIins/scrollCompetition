<?xml version="1.0" encoding="utf-8"?>
<!-- Pas de sauvegarde cloud ni de transfert : la clé perso reste sur ce téléphone -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
